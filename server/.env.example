# Copy to .env and adjust. NEVER commit a real .env.
NODE_ENV=development
PORT=3000
# Reverse-proxy hops in front of the API (e.g. 1 behind nginx/ALB). Needed for correct client IPs.
TRUST_PROXY=0

# Comma-separated list of browser origins allowed to call the API (CORS + Origin check).
CORS_ORIGINS=http://localhost:4200

# SQLite file path (":memory:" is used by tests).
DATABASE_PATH=./data/auth.db

# HMAC secrets — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_MFA_SECRET=change-me-to-another-long-random-string-32-chars

# 32 random bytes, base64url — encrypts TOTP secrets at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=

JWT_ISSUER=advance-auth
JWT_AUDIENCE=advance-auth-web

ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800      # 7 days sliding (idle) lifetime
SESSION_ABSOLUTE_TTL_SECONDS=2592000  # 30 days hard cap, re-login required after

# Public URL of the web app, used to build links in e-mails.
APP_URL=http://localhost:4200

# Bootstrap super admin created by `npm run seed` (only if no super admin exists yet).
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!SuperAdmin2026
